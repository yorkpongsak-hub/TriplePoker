NODE_ENV=development
PORT=3001

# Use the current keys shown in Supabase Project Settings. Never commit real values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-current-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-current-secret-key

# Comma-separated browser origins. Native Android requests normally have no Origin header.
ALLOWED_ORIGINS=https://your-production-web-origin.example

# Version 1.0 release gates are fail-closed unless explicitly enabled.
SOVEREIGN_ENABLED=false
VIP_PLUS_5P_ENABLED=false
VIP_PRIVATE_CREW_ENABLED=false
MONARCH_ENABLED=false
