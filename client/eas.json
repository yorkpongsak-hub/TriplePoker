{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_AD_MODE": "google_test" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_AD_MODE": "google_test" }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_AD_MODE": "mock",
        "EXPO_PUBLIC_AD_RELEASE_GATE": "disabled",
        "EXPO_PUBLIC_ARENA_ENABLED": "false",
        "EXPO_PUBLIC_SOVEREIGN_ENABLED": "false",
        "EXPO_PUBLIC_VIP_PLUS_ENABLED": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
