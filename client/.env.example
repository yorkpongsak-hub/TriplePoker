EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SERVER_URL=

# mock (default), google_test (Android development / preview), or production.
EXPO_PUBLIC_AD_MODE=mock

# Production only: both the mode and this gate must be explicitly set.
# EXPO_PUBLIC_AD_MODE=production
# EXPO_PUBLIC_AD_RELEASE_GATE=enabled
# ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxx~xxxxxxxx
# EXPO_PUBLIC_ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
