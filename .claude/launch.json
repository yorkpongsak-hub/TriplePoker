{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/nodemon/bin/nodemon.js", "--watch", "src", "--ext", "ts", "--exec", "node -r ts-node/register src/index.ts"],
      "cwd": "server",
      "port": 3001
    },
    {
      "name": "client-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web"],
      "cwd": "client",
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "client-web-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8090"],
      "cwd": "client",
      "port": 8090
    }
  ]
}
